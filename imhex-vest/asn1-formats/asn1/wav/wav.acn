-- Generated from an ImHex pattern by hexpat's ASN.1/ACN emitter.
Wav-Module DEFINITIONS ::= BEGIN

RiffHeader [] {
    riff [],
    size [encoding pos-int, size 32, endianness little],
    wave []
}

Format-T [encoding pos-int, size 16, endianness little]

FmtChunk [] {
    id [],
    size [encoding pos-int, size 32, endianness little],
    format [],
    channels [encoding pos-int, size 16, endianness little],
    sampleRate [encoding pos-int, size 32, endianness little],
    byteRate [encoding pos-int, size 32, endianness little],
    blockAlign [encoding pos-int, size 16, endianness little],
    bitsPerSample [encoding pos-int, size 16, endianness little]
}

Wav [] {
    riff [],
    fmt []
}

END
