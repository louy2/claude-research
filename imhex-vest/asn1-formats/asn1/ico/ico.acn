-- Generated from an ImHex pattern by hexpat's ASN.1/ACN emitter.
Ico-Module DEFINITIONS ::= BEGIN

ImageType [encoding pos-int, size 16, endianness little]

Header [] {
    reserved [encoding pos-int, size 16, endianness little],
    type-field [],
    count [encoding pos-int, size 16, endianness little]
}

DirEntry [] {
    width [encoding pos-int, size 8],
    height [encoding pos-int, size 8],
    colorCount [encoding pos-int, size 8],
    reserved [encoding pos-int, size 8],
    planes [encoding pos-int, size 16, endianness little],
    bitCount [encoding pos-int, size 16, endianness little],
    size [encoding pos-int, size 32, endianness little],
    offset [encoding pos-int, size 32, endianness little]
}

Ico [] {
    header-reserved [encoding pos-int, size 16, endianness little],
    header-type [],
    header-count INTEGER [encoding pos-int, size 16, endianness little],
    entries [size header-count]
}

END
